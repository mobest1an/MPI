<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE tsung SYSTEM "/usr/local/share/tsung/tsung-1.0.dtd">

<tsung loglevel="debug" version="1.0">

    <clients>
        <client host="localhost" use_controller_vm="true" maxusers="10000" />
    </clients>

    <!-- Spring app on host -->
    <servers>
        <server host="app" port="8080" type="tcp" />
    </servers>

    <load>
        <arrivalphase phase="1" duration="30" unit="second">
            <users maxnumber="90" arrivalrate="3" unit="second"/>
        </arrivalphase>
        <arrivalphase phase="2" duration="50" unit="second">
            <users maxnumber="5000" arrivalrate="100" unit="second"/>
        </arrivalphase>
    </load>

    <options>
        <option name="file_server" value="/root/.tsung/users" id="users"/>
    </options>

    <sessions>
        <session name="recruit-queue" probability="100" type="ts_http">

            <!-- one (username,password) per virtual user -->
            <setdynvars sourcetype="file" fileid="users" delimiter="," order="iter">
                <var name="username"/>
                <var name="password"/>
            </setdynvars>

            <!-- 0) REGISTER -->
            <request subst="true">
                <http url="/api/v1/auth/register" method="POST" version="1.1"
                      contents='{"username":"%%_username%%","password":"%%_password%%"}'>
                    <http_header name="Content-Type" value="application/json"/>
                    <http_header name="Accept" value="application/json"/>
                </http>
            </request>
        </session>
    </sessions>

</tsung>
